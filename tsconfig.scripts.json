{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "out/types-scripts",
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "scripts/**/*",
    "src/main/**/*",
    "src/mcp/**/*",
    "src/shared/**/*",
    "src/renderer/src/editor/markdown.ts",
    "src/renderer/src/editor/markdownToDoc.ts",
    "src/renderer/src/editor/userTextMark.ts"
  ]
}
